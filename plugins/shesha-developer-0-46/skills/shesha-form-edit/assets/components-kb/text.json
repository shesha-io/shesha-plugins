  "sourceFiles": [
    "text/index.tsx",
    "text/models.ts"
  ],
  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 3,
      "category": "STYLE_BLOCKS",
      "what": "migratePrevStyles(prev, defaultStyles(prev)): font/color/background/border/dimensions/stylingBox into style blocks; defaults font Segoe UI 400 14px #000, width fit-content, margins/paddings 0, border none (text/utils.ts:"
    },
    {
      "toVersion": 5,
      "category": "curated",
      "what": "font size: FONT_SIZES[prev.fontSize] rem -> px using a HARD-CODED 14px root (remToPx). text-sm 14->12.25px, text-base 16->14px, text-lg 18->15.75px, text-xl 20->17.5px. text-2xl and text-6xl have a stray \";\" in the table"
    },
    {
      "toVersion": 6,
      "category": "curated",
      "what": "desktop.level set from textType===\"title\" && Number.isInteger(level) else 0 (non-title text always paragraph)"
    },
    {
      "toVersion": 7,
      "category": "VISIBLE_STYLINGJSON",
      "what": "Mustache rewrite: contentDisplay===\"name\" -> \"{{data.<propertyName>}}\"; otherwise every \"{{\" -> \"{{data.\" (and \"{{{\" kept). Content that already says {{data.x}} becomes {{data.data.x}}; {{contexts.x}} becomes {{data.cont"
    }
  ]
