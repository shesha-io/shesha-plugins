      "borderRadius",
      "borderStyle",
      "borderWidth",
      "buttonType",
      "childItems",
      "color",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "danger",
      "description",
      "desktop",
      "dimensions",
      "disabled",
      "dividerColor",
      "dividerWidth",
      "downIcon",
      "dynamicItem",
      "editMode",
      "editModePermissions",
      "enableStyleOnReadonly",
      "font",
      "fontSize",
      "fontWeight",
      "ghost",
      "height",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "icon",
      "iconPosition",
      "id",
      "initialContext",
      "isDynamic",
      "itemSubType",
      "itemType",
      "jsSetting",
      "jsStyle",
      "label",
      "labelAlign",
      "layout",
      "mobile",
      "name",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onDoubleClickCustom",
      "onFocusCustom",
      "onInputCustom",
      "onKeyDownCustom",
      "onKeyUpCustom",
      "onMouseEnterCustom",
      "onMouseLeaveCustom",
      "onMouseMoveCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "shadow",
      "size",
      "sortOrder",
      "style",
      "styleCss",
      "styles",
      "stylingBox",
