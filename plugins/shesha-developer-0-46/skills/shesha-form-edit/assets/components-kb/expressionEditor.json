{
  "type": "expressionEditor",
  "name": "Expression Editor",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "FunctionOutlined",
  "version": 2,
  "allowInherit": false,
  "styleGroup": null,
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": null,
  "initModel": {
    "defaults": {
      "label": "Expression Editor"
    },
    "raw": "(model) => ({\n    ...model,\n    label: 'Expression Editor',\n  })"
  },
  "settingsProps": {
    "interfaceName": "IExpressionEditorComponentProps",
    "interfaceFile": "designer-components/expressionEditor/interfaces.ts",
    "ownProps": [
      "placeholder",
      "value"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "availableConstantsExpression",
      "background",
      "border",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "disabled",
      "editMode",
      "editModePermissions",
      "enableStyleOnReadonly",
      "font",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "isDynamic",
      "jsSetting",
      "jsStyle",
      "label",
      "labelAlign",
      "layout",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onDoubleClickCustom",
      "onFocusCustom",
      "onInputCustom",
      "onKeyDownCustom",
      "onKeyUpCustom",
      "onMouseEnterCustom",
      "onMouseLeaveCustom",
      "onMouseMoveCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "placeholder",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "shadow",
      "size",
      "style",
      "styleCss",
      "stylingBox",
      "stylingBoxJson",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "validationDependencies",
      "value",
      "version",
      "visible",
      "visiblePermissions",
      "wrapperStyle",
      "wrapperStyleCss"
    ],
    "unresolvedExtends": []
  },
  "settingsForm": {
    "source": "expressionEditor/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs"
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "propertyAutocomplete",
      "required": true
    },
    {
      "path": "label",
      "label": "Label",
      "editorType": "textField"
    },
    {
      "path": "placeholder",
      "label": "Placeholder",
      "editorType": "textField"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "switch"
    },
    {
      "path": "readOnly",
      "label": "Read Only",
      "editorType": "switch"
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "permissions"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "expressionEditor/index.tsx",
    "expressionEditor/interfaces.ts"
  ],
  "reworked": false,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 2,
      "category": "READONLY",
      "what": "readOnly/disabled -> editMode (Interaction Mode)"
    }
  ]
}
