    },
    {
      "toVersion": 16,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    },
    {
      "toVersion": 17,
      "category": "curated",
      "what": "container and thumbnail style sets swapped (fix of v9)"
    },
    {
      "toVersion": 18,
      "category": "curated",
