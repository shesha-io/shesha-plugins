{
  "type": "phoneNumberInput",
  "name": "Phone Number",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "PhoneOutlined",
  "version": 7,
  "allowInherit": true,
  "styleGroup": "inputs",
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": "() => defaultStyles()",
  "initModel": {
    "defaults": null,
    "raw": "(model) => ({\n    ...model,\n    valueFormat: model.valueFormat || 'string',\n    stripCountryCode: model.stripCountryCode ?? false,\n    defaultCountry: model.defaultCountry || 'za',\n    enableArrow: model.enableArrow ?? true,\n    labelAlign: model.labelAlign || 'left',\n  })"
  },
  "settingsProps": {
    "interfaceName": "IPhoneNumberComponentProps",
    "interfaceFile": "designer-components/phoneNumber/interfaces.ts",
