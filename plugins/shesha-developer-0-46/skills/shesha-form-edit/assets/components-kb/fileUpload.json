    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "How the selected file is presented: as its name, or as a tile at a preset size. Custom Thumbnail takes its size from the Dimensions panel."
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    },
    {
      "path": "editMode",
      "label": "Interaction Mode",
      "editorType": "editModeSelector",
      "permissionSettings": true
    },
    {
      "path": "displayStyle",
      "label": "Display Style",
      "editorType": "dropdown",
      "description": "How the selected file is presented: as its name, or as a tile at a preset size. Custom Thumbnail takes its size from the Dimensions panel.",
      "group": "Display"
    },
    {
      "path": "isDragger",
      "label": "Is Dragger",
      "editorType": "switch",
      "description": "Whether the uploader should show a drop area instead of a button",
      "group": "Display"
    },
    {
      "path": "hideFileName",
      "label": "Hide File Name",
      "editorType": "switch",
      "group": "Display"
    },
    {
      "path": "allowUpload",
      "label": "Allow Upload",
      "editorType": "switch",
      "group": "Files"
    },
    {
      "path": "allowReplace",
      "label": "Allow Replace",
      "editorType": "switch",
      "group": "Files"
    },
    {
      "path": "allowDelete",
      "label": "Allow Delete",
      "editorType": "switch",
      "group": "Files"
    },
    {
      "path": "useSync",
      "label": "Synchronous Upload",
      "editorType": "switch",
      "description": "Upload the file with the form submission rather than immediately on selection",
      "group": "Files"
    },
    {
      "path": "allowedFileTypes",
      "label": "Allowed File Types",
      "editorType": "editableTagGroupProps",
      "description": "File types that can be accepted. The file type should include the leading dot, for example: .png",
      "group": "Files"
    },
    {
      "path": "ownerId",
      "label": "Owner ID",
      "editorType": "textField",
      "description": "Id of the entity the file is attached to. Defaults to the form data entity when empty",
      "group": "Files"
    },
    {
      "path": "ownerType",
      "label": "Owner Type",
      "editorType": "entityTypeAutocomplete",
      "description": "Type of the entity the file is attached to. Defaults to the form model type when empty",
      "group": "Files"
    },
    {
      "path": "validate.required",
      "label": "Required",
      "editorType": "switch",
      "group": "Validations"
    },
    {
