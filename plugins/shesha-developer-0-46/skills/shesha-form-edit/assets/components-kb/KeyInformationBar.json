      "container",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "disabled",
      "dividerColor",
      "dividerHeight",
      "dividerMargin",
      "dividerThickness",
      "dividerWidth",
      "editMode",
      "editModePermissions",
      "enableStyleOnReadonly",
      "font",
      "fontColor",
      "fontSize",
      "fontWeight",
      "gap",
      "height",
      "hidden",
      "hideBorder",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "isDynamic",
      "itemsStyle",
      "jsSetting",
      "jsStyle",
      "label",
      "labelAlign",
      "layout",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
