  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "stylingBox",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Enter code to get form identifier. You must return { name: string; module?: string; version?: number; } object. The global variable data is provided, and allows you to access the data of any form component, by using its API key."
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "textField",
      "required": true
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    },
    {
      "path": "formSelectionMode",
      "label": "Form Selection Mode",
      "editorType": "dropdown",
      "options": [
        "name",
        "view",
        "expression"
      ]
    },
    {
      "path": "formType",
      "label": "Form Type",
      "editorType": "formTypeAutocomplete"
    },
    {
      "path": "formId",
      "label": "Form",
      "editorType": "formAutocomplete",
      "required": true
    },
    {
      "path": "formIdExpression",
      "label": "Form Identifier Expression",
      "editorType": "codeEditor",
      "description": "Enter code to get form identifier. You must return { name: string; module?: string; version?: number; } object. The global variable data is provided, and allows you to access the data of any form component, by using its API key."
    },
    {
      "path": "selectionMode",
      "label": "Selection Mode",
      "editorType": "dropdown",
      "options": [
        "none",
        "single",
        "multiple"
      ]
    },
    {
      "path": "canAddInline",
      "label": "Can Add Inline",
      "editorType": "dropdown",
      "options": [
        "yes",
        "no",
        "inherit"
      ]
    },
    {
      "path": "createFormId",
      "label": "Form",
      "editorType": "formAutocomplete",
      "required": true
    },
    {
      "path": "createFormType",
      "label": "Form Type",
      "editorType": "formTypeAutocomplete"
    },
    {
      "path": "customCreateUrl",
      "label": "Custom Create URL",
      "editorType": "endpointsAutocomplete"
    },
    {
      "path": "onNewListItemInitialize",
      "label": "New List Item Init",
      "editorType": "codeEditor",
      "description": "Custom code to initialize new list items with default values or setup logic"
    },
    {
      "path": "modalWidth",
      "label": "Dialog Width",
      "editorType": "customDropdown",
      "options": [
        "40%",
        "60%",
        "80%"
      ]
    },
    {
      "path": "canEditInline",
      "label": "Can Edit Inline",
      "editorType": "dropdown",
      "options": [
        "yes",
        "no",
        "inherit"
      ]
    },
    {
      "path": "showEditIcons",
      "label": "Show Edit Icon",
      "editorType": "switch"
    },
    {
      "path": "inlineEditMode",
      "label": "Edit Mode",
      "editorType": "dropdown",
      "options": [
        "all-at-once",
        "one-by-one"
      ]
    },
    {
      "path": "inlineSaveMode",
      "label": "Save Mode",
      "editorType": "dropdown",
      "options": [
        "auto",
        "manual"
      ]
    },
    {
      "path": "customUpdateUrl",
      "label": "Custom Update URL",
      "editorType": "endpointsAutocomplete"
    },
    {
      "path": "canDeleteInline",
      "label": "Can Delete Inline",
      "editorType": "dropdown",
