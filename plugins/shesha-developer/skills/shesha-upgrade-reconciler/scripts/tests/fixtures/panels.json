{
 "rule": "panels",
 "cases": [
  {
   "name": "header padding replaced when the option is set",
   "form": "Shop/order-details",
   "markup": {
    "components": [
     {
      "id": "pnl",
      "type": "collapsiblePanel",
      "componentName": "pnl",
      "parentId": "root",
      "desktop": {
       "headerStyles": {
        "stylingBoxJson": {
         "_type": "styleBox",
         "paddingTop": "8",
         "paddingRight": "8",
         "paddingBottom": "8",
         "paddingLeft": "8"
        }
       }
      }
     }
    ]
   },
   "changes": 1,
   "expect": [
    [
     "components/0/desktop/headerStyles/stylingBoxJson/paddingTop",
     "4"
    ],
    [
     "components/0/desktop/headerStyles/stylingBoxJson/paddingRight",
     "0"
    ],
    [
     "components/0/desktop/headerStyles/stylingBoxJson/paddingBottom",
     "0"
    ],
    [
     "components/0/desktop/headerStyles/stylingBoxJson/paddingLeft",
     "12"
    ]
   ],
   "node": false,
   "retire": false,
   "options": {
    "panelHeaderPadding": {
     "paddingTop": "4",
     "paddingRight": "0",
     "paddingBottom": "0",
     "paddingLeft": "12"
    }
   }
  },
  {
   "name": "no option, no change",
   "form": "Shop/order-details",
   "markup": {
    "components": [
     {
      "id": "pnl",
      "type": "collapsiblePanel",
      "componentName": "pnl",
      "parentId": "root",
      "desktop": {
       "headerStyles": {
        "stylingBoxJson": {
         "_type": "styleBox",
         "paddingTop": "8",
         "paddingRight": "8",
         "paddingBottom": "8",
         "paddingLeft": "8"
        }
       }
      }
     }
    ]
   },
   "changes": 0,
   "expect": [],
   "node": false,
   "retire": false
  }
 ]
}
