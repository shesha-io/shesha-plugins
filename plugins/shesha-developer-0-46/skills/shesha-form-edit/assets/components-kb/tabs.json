  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 1,
      "category": "READONLY",
      "what": "readOnly/disabled -> editMode (Interaction Mode)"
    },
    {
      "toVersion": 4,
      "category": "STYLE_BLOCKS",
      "what": "migratePrevStyles(prev, tabs defaultStyles) + overflow:true + card = defaultCardStyles with font.color #000000: tabs get white background (#FFFFFF), 1px #f0f0f0 border on all sides, radius 8 (top corners squared by posit"
    },
    {
      "toVersion": 11,
      "category": "VISIBLE_STYLINGJSON",
      "what": "Per tab: selectMode \"readOnly\" -> editMode \"disabled\", hidden -> visible (default true), permissions -> visiblePermissions; component: hidden->visible, stylingBox -> stylingBoxJson. NOTE no step re-creates the per-tab-pa"
    }
  ]
