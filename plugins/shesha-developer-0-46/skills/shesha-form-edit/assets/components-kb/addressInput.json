  "hasStandardAppearance": false,
  "appearanceFieldPaths": [],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Google Maps JavaScript API key. Must have the Places and Maps libraries enabled."
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "placeholder",
      "label": "Placeholder",
      "editorType": "textField"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "editMode",
      "label": "Edit Mode",
      "editorType": "editModeSelector"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "switch"
    },
    {
      "path": "googleMapsApiKey",
      "label": "Google Maps API Key",
      "editorType": "Password",
      "description": "Google Maps JavaScript API key. Must have the Places and Maps libraries enabled."
    },
    {
      "path": "enableMapInterface",
      "label": "Enable Map Interface",
      "editorType": "switch",
      "description": "Show a map pin button to open an interactive map dialog for picking a location."
    },
    {
      "path": "latitudePropertyName",
      "label": "Latitude Property",
      "editorType": "textField",
      "description": "Dot-notation path where latitude will be written, e.g. \"address.latitude\"."
    },
    {
      "path": "longitudePropertyName",
      "label": "Longitude Property",
      "editorType": "textField",
      "description": "Dot-notation path where longitude will be written, e.g. \"address.longitude\"."
    },
    {
      "path": "defaultZoom",
      "label": "Default Zoom",
      "editorType": "numberField",
      "description": "Initial zoom level of the map (1–20). Defaults to 15."
    },
    {
      "path": "mapHeight",
      "label": "Map Height (px)",
      "editorType": "numberField",
      "description": "Height in pixels of the map inside the dialog. Defaults to 400."
    },
    {
      "path": "mapWidth",
      "label": "Map Width (px)",
      "editorType": "numberField",
      "description": "Width in pixels of the map inside the dialog. Defaults to full width."
    },
    {
      "path": "validate.required",
      "label": "Required",
      "editorType": "switch"
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "permissions",
      "description": "Permissions required to see and interact with this component."
    }
  ],
