{
  "type": "datatable.quickSearch",
  "name": "Quick Search",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "SearchOutlined",
  "version": 4,
  "allowInherit": true,
  "styleGroup": null,
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": null,
  "initModel": {
    "defaults": {
      "size": "small"
    },
    "raw": "(model: IQuickSearchComponentProps) => ({ ...model, items: [], size: 'small' })"
  },
  "settingsProps": {
    "interfaceName": "IConfigurableFormComponent",
    "interfaceFile": "providers/form/models.ts",
    "ownProps": [
      "type",
      "description",
      "validate",
      "validationDependencies",
      "readOnly",
      "disabled",
      "editMode",
      "editModePermissions",
      "customEnabled",
      "size",
      "isDynamic",
      "jsSetting",
      "availableConstantsExpression",
      "subscribedEventNames",
      "noDataText",
      "noDataIcon",
      "noDataSecondaryText",
      "permissions",
      "_formFields",
      "layout",
      "desktop",
      "tablet",
      "mobile",
      "allStyles",
      "enableStyleOnReadonly",
      "jsStyle"
    ],
    "extends": [
      "IFormComponentContainer",
      "IHasVersion",
      "IComponentBindingProps",
      "IComponentLabelProps",
      "IComponentVisibilityProps",
      "IComponentEventHandlers",
      "IStyleValue"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "availableConstantsExpression",
      "background",
      "border",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "disabled",
      "editMode",
      "editModePermissions",
      "enableStyleOnReadonly",
      "font",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "isDynamic",
      "jsSetting",
      "jsStyle",
      "label",
      "labelAlign",
      "layout",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onDoubleClickCustom",
      "onFocusCustom",
      "onInputCustom",
      "onKeyDownCustom",
      "onKeyUpCustom",
      "onMouseEnterCustom",
      "onMouseLeaveCustom",
      "onMouseMoveCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "shadow",
      "size",
      "style",
      "styleCss",
      "stylingBox",
      "stylingBoxJson",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "validationDependencies",
      "version",
      "visible",
      "visiblePermissions",
      "wrapperStyle",
      "wrapperStyleCss"
    ],
    "unresolvedExtends": []
  },
  "settingsForm": {
    "source": "dataTable/quickSearch/tabbedSettingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": true,
  "appearanceFieldPaths": [
    "dimensions"
  ],
  "appearanceScope": "per-device",
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs"
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "textField",
      "required": true
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "dataTable/quickSearch/quickSearchComponent.tsx",
    "../providers/form/models.ts"
  ],
  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 3,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    },
    {
      "toVersion": 4,
      "category": "VISIBLE_STYLINGJSON",
      "what": "hidden -> visible (inverted), stylingBox -> stylingBoxJson, permissions -> visiblePermissions"
    }
  ]
}
