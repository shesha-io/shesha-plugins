{
  "type": "datatable.filter",
  "name": "Table Filter",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "FilterOutlined",
  "version": 7,
  "allowInherit": true,
  "styleGroup": "common",
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": "defaultStyles",
  "initModel": {
    "defaults": {
      "label": ""
    },
    "raw": "(model): IAdvancedFilterButtonComponentProps => ({ ...model, label: '' })"
  },
  "settingsProps": {
    "interfaceName": "IAdvancedFilterButtonComponentProps",
    "interfaceFile": "designer-components/dataTable/advancedFilterButton/types.ts",
    "ownProps": [],
    "extends": [
      "IButtonComponentProps"
    ],
    "resolvedProps": [
      "_formFields",
      "actionConfiguration",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "availableConstantsExpression",
      "background",
      "backgroundColor",
      "block",
