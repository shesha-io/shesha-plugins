{
  "type": "card",
  "name": "Card",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "CodeSandboxSquareFilled",
  "version": 5,
  "allowInherit": true,
  "styleGroup": null,
  "isHidden": false,
  "customContainerNames": [
    "header",
    "content"
  ],
  "hasGetContainers": false,
  "defaultStylesFrom": "defaultStyles",
  "initModel": {
    "defaults": null,
    "raw": "(model) => ({\n    ...model,\n    header: { id: nanoid(), components: [] },\n    content: { id: nanoid(), components: [] },\n  })"
  },
  "settingsProps": {
    "interfaceName": "ICardComponentProps",
    "interfaceFile": "designer-components/card/interfaces.ts",
    "ownProps": [
      "className",
      "content",
      "header",
      "hideHeading",
      "hideWhenEmpty",
      "border",
      "shadow",
      "background"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "availableConstantsExpression",
      "background",
      "border",
      "className",
      "componentName",
      "content",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "disabled",
      "editMode",
      "editModePermissions",
      "enableStyleOnReadonly",
      "font",
      "header",
      "hidden",
      "hideHeading",
      "hideLabel",
      "hideScrollBar",
      "hideWhenEmpty",
      "id",
      "initialContext",
      "isDynamic",
      "jsSetting",
      "jsStyle",
      "label",
      "labelAlign",
      "layout",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onDoubleClickCustom",
      "onFocusCustom",
      "onInputCustom",
      "onKeyDownCustom",
      "onKeyUpCustom",
      "onMouseEnterCustom",
      "onMouseLeaveCustom",
      "onMouseMoveCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "shadow",
      "size",
      "style",
      "styleCss",
      "stylingBox",
      "stylingBoxJson",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "validationDependencies",
      "version",
      "visible",
      "visiblePermissions",
      "wrapperStyle",
      "wrapperStyleCss"
    ],
    "unresolvedExtends": []
  },
  "settingsForm": {
    "source": "card/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": true,
  "appearanceFieldPaths": [
    "dimensions",
    "stylingBoxJson",
    "border",
    "background",
    "shadow"
  ],
  "appearanceScope": "per-device",
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties"
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "textField",
      "required": true
    },
    {
      "path": "label",
      "label": "Heading",
      "editorType": "textField"
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    },
    {
      "path": "editMode",
      "label": "Interaction Mode",
      "editorType": "editModeSelector",
      "permissionSettings": true
    },
    {
      "path": "hideHeading",
      "label": "Hide Heading",
      "editorType": "switch"
    },
    {
      "path": "hideWhenEmpty",
      "label": "Hide When Empty",
      "editorType": "switch"
    },
    {
      "path": "onClickCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onDoubleClickCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onMouseEnterCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onMouseMoveCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onMouseLeaveCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "codeEditor",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles"
    },
    {
      "path": "className",
      "label": "Custom CSS Class",
      "editorType": "textField",
      "group": "Custom Styles"
    }
  ],
  "slots": {
    "hostsChildren": true,
    "customContainerNames": [
      "header",
      "content"
    ],
    "detectedSlotKeys": [
      "header",
      "content"
    ],
    "usesComponentsContainer": true
  },
  "sourceFiles": [
    "card/index.tsx",
    "card/interfaces.ts"
  ],
  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 3,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    },
    {
      "toVersion": 4,
      "category": "curated",
      "what": "forces desktop/tablet/mobile dimensions width \"auto\" and height \"fit-content\""
    },
    {
      "toVersion": 5,
      "category": "VISIBLE_STYLINGJSON",
      "what": "hidden -> visible (inverted), stylingBox -> stylingBoxJson, permissions -> visiblePermissions"
    }
  ]
}
