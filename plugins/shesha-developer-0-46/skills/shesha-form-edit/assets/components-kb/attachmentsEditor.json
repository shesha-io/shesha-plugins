      "label": "File Group",
      "editorType": "textField",
      "group": "Data"
    },
    {
      "path": "allowedFileTypes",
      "label": "Accepted File Types",
      "editorType": "editableTagGroupProps",
      "description": "File types that can be accepted. The file type should include the leading dot, for example .png",
      "group": "Data"
    },
    {
      "path": "customActions",
      "label": "Custom Actions",
      "editorType": "buttonGroupConfigurator",
      "description": "Configure custom actions that appear when hovering over files.",
      "group": "Custom"
    },
    {
      "path": "customContent",
      "label": "Show Custom Content",
      "editorType": "switch",
      "description": "Enable to show custom content below each file.",
      "group": "Custom"
    },
