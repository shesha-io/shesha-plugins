{
 "rule": "rowgap",
 "cases": [
  {
   "name": "horizontal container without a gap",
   "form": "Shop/order-details",
   "markup": {
    "components": [
     {
      "id": "row",
      "type": "container",
      "componentName": "row",
      "parentId": "root",
      "direction": "horizontal",
      "desktop": {}
     }
    ]
   },
   "changes": 1,
   "expect": [
