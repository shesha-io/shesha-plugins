      "label": "Parent Entity Type",
      "editorType": "entityTypeAutocomplete",
      "group": "Data"
    },
    {
      "path": "ownerId",
      "label": "Parent Record ID",
      "editorType": "textField",
      "group": "Data"
    },
    {
