  "settingsForm": {
    "source": "statusTag/settings.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": true,
  "appearanceFieldPaths": [
    "font",
    "dimensions",
    "border",
    "background",
    "shadow",
    "stylingBoxJson",
    "style"
  ],
  "appearanceScope": "per-device",
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Text that gets displayed when the bound property has no value."
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    },
    {
      "path": "readOnlyPlaceholder",
      "label": "Placeholder",
      "editorType": "textField",
      "description": "Text that gets displayed when the bound property has no value."
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "enableMultiSelect",
      "label": "Enable Multi-Select",
      "editorType": "switch"
    },
    {
      "path": "dataSourceType",
      "label": "Data source",
      "editorType": "dropdown",
      "description": "Where the statuses come from. A reference list is the usual source; Values lets you define them inline on the form.",
      "required": true
    },
    {
      "path": "referenceListId",
      "label": "Reference List",
      "editorType": "referenceListAutocomplete",
      "required": true
    },
    {
      "path": "filter",
      "label": "Filter",
      "editorType": "queryBuilder",
      "group": "Advanced"
    },
    {
      "path": "ignoredValues",
      "label": "Hidden values",
      "editorType": "textArea",
      "description": "Pass an array of positive integers to hide specific values. For example: [1, 2, 3].",
      "group": "Advanced"
    },
    {
      "path": "values",
      "label": "Values",
      "editorType": "customLabelValueEditor"
    },
    {
      "path": "showItemName",
      "label": "Show Label",
      "editorType": "switch",
      "description": "When checked the DisplayName/RefList Name will be shown."
    },
    {
      "path": "showIcon",
      "label": "Show Icon",
      "editorType": "switch",
      "description": "When checked the icon will display on the left side of the DisplayName"
    },
    {
      "path": "tagVariant",
      "label": "Variant",
      "editorType": "dropdown",
      "description": "How each tag is filled when the status carries its own colour. Solid fills the tag, Outlined draws a coloured border, Filled applies a soft tint."
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "statusTag/index.tsx",
    "statusTag/model.ts"
  ],
  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 3,
      "category": "curated",
      "what": "mappings/valueSource model replaced by dataSourceType + values; showItemName/showIcon/tagVariant defaults"
    },
    {
      "toVersion": 4,
      "category": "STYLE_COPY",
      "what": "Root-level legacy style props copied into desktop/tablet/mobile blocks (precursor of migratePrevStyles)"
    },
    {
      "toVersion": 5,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    },
    {
      "toVersion": 6,
      "category": "VISIBLE_STYLINGJSON",
      "what": "hidden -> visible (inverted), stylingBox -> stylingBoxJson, permissions -> visiblePermissions"
    }
  ]
}
