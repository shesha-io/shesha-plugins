  "settingsForm": {
    "source": "colorPicker/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "size",
    "stylingBox",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Title shown at the top of the color picker"
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "editMode",
      "label": "Edit Mode",
      "editorType": "editModeSelector"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "switch"
    },
    {
      "path": "title",
      "label": "Title",
      "editorType": "textField",
      "description": "Title shown at the top of the color picker"
    },
    {
      "path": "allowClear",
      "label": "Allow Clear",
      "editorType": "switch"
    },
    {
      "path": "showText",
      "label": "Show Color Code",
      "editorType": "switch",
      "description": "Shows the color value (hex/rgb) alongside the color preview"
    },
    {
      "path": "disabledAlpha",
      "label": "Disable Opacity",
      "editorType": "switch",
      "description": "Removes the opacity/transparency option from the color picker"
    },
    {
      "path": "onChangeCustom",
      "label": "On Change",
      "editorType": "codeEditor",
      "description": "Enter custom eventhandler on changing of event."
    },
    {
      "path": "size",
      "label": "Size",
      "editorType": "dropdown",
      "options": [
        "small",
        "middle",
        "large"
      ],
      "group": "Styles",
      "shared": true
    },
    {
      "path": "stylingBox",
      "label": "Margin & Padding",
      "editorType": "styleBox",
      "group": "Margin & Padding",
      "shared": true
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "codeEditor",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "permissions",
      "description": "Enter a list of permissions that should be associated with this component"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
