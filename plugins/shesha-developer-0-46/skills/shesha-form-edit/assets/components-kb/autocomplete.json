{
  "type": "autocomplete",
  "name": "Autocomplete",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "FileSearchOutlined",
  "version": 9,
  "allowInherit": true,
  "styleGroup": "inputs",
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": "() => defaultStyles()",
  "initModel": null,
  "settingsProps": {
    "interfaceName": "IAutocompleteComponentProps",
