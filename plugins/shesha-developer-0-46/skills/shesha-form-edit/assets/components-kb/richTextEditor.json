        "tab",
        "xpath",
        "image-properties",
        "image-processor",
        "image",
        "media",
        "video",
        "file",
        "resize-cells",
        "select-cells",
        "table-keyboard-navigation",
        "table",
        "preview",
        "print"
      ],
      "group": "Toolbar"
    },
    {
      "path": "autofocus",
      "label": "Auto Focus",
      "editorType": "switch",
      "description": "If yes, will automatically be focused (be selected component) when the page loads",
      "group": "Options"
    },
    {
      "path": "preset",
      "label": "Presets",
      "editorType": "dropdown",
      "description": "Choose a pre-configured toolbar layout",
      "options": [
        "null",
        "inline"
      ],
      "group": "Options"
    },
    {
      "path": "direction",
      "label": "Direction",
      "editorType": "dropdown",
      "options": [
        "",
        "rtl",
        "ltr"
      ],
      "group": "Display"
    },
    {
      "path": "showCharsCounter",
      "label": "Show Characters Counter",
      "editorType": "switch",
      "group": "Display"
    },
    {
      "path": "showWordsCounter",
      "label": "Show Words Counter",
      "editorType": "switch",
      "group": "Display"
    },
    {
      "path": "enter",
      "label": "Element That Will Be Created On Enter",
      "editorType": "dropdown",
      "options": [
        "BR",
        "P",
        "DIV"
      ],
      "group": "Advanced"
    },
    {
      "path": "insertImageAsBase64URI",
      "label": "Insert Image As Base64 URI",
      "editorType": "switch",
      "group": "Advanced"
    },
    {
      "path": "iframe",
      "label": "Iframe Mode",
      "editorType": "switch",
      "description": "Isolates the editor content in a separate iframe for better style separation",
      "group": "Advanced"
    },
    {
      "path": "saveHeightInStorage",
      "label": "Remember Height",
      "editorType": "switch",
      "description": "Remembers the editor height for the next session",
      "group": "Advanced"
    },
    {
      "path": "saveModeInStorage",
      "label": "Remember Mode",
      "editorType": "switch",
      "description": "Remembers the editor mode (WYSIWYG/Source) for the next session",
      "group": "Advanced"
    },
    {
      "path": "askBeforePasteHTML",
      "label": "Ask Before Paste HTML",
      "editorType": "switch",
      "description": "If yes, will ask the user to confirm before allowing content copied from a Web page to be pasted in",
      "group": "Advanced"
    },
    {
      "path": "askBeforePasteFromWord",
      "label": "Ask Before Paste From Word/Excel",
      "editorType": "switch",
      "description": "If yes, will ask the user to confirm before allowing content from Excel or Word to be pasted in",
      "group": "Advanced"
    },
    {
      "path": "theme",
      "label": "Theme",
      "editorType": "dropdown",
      "options": [
        "default",
        "dark"
      ]
    },
    {
      "path": "autoWidth",
      "label": "Auto Width",
      "editorType": "switch",
      "group": "Dimensions"
    },
    {
      "path": "autoHeight",
      "label": "Auto Height",
      "editorType": "switch",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.width",
      "label": "Width",
      "editorType": "textField",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.minWidth",
      "label": "Min Width",
      "editorType": "textField",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.maxWidth",
      "label": "Max Width",
      "editorType": "textField",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.height",
      "label": "Height",
      "editorType": "textField",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.minHeight",
      "label": "Min Height",
      "editorType": "textField",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.maxHeight",
      "label": "Max Height",
      "editorType": "textField",
      "group": "Dimensions"
    },
    {
      "path": "allowResizeX",
      "label": "Allow Width Resize",
      "editorType": "switch",
      "group": "Dimensions"
    },
    {
      "path": "allowResizeY",
      "label": "Allow Height Resize",
      "editorType": "switch",
      "group": "Dimensions"
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "codeEditor",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "permissions"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "richTextEditor/index.tsx",
    "richTextEditor/interfaces.ts"
  ],
  "reworked": false,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 1,
      "category": "READONLY",
      "what": "readOnly/disabled -> editMode (Interaction Mode)"
    },
    {
      "toVersion": 3,
      "category": "STYLE_COPY",
      "what": "Root-level legacy style props copied into desktop/tablet/mobile blocks (precursor of migratePrevStyles)"
    },
    {
      "toVersion": 6,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    }
  ]
}
