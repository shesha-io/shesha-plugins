{
  "type": "statusTag",
  "name": "Status Tag",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "TagOutlined",
  "version": 6,
  "allowInherit": true,
  "styleGroup": "inputs",
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": "() => defaultStyles()",
  "initModel": {
    "defaults": {
      "dataSourceType": "referenceList",
      "showItemName": true,
      "showIcon": true,
      "tagVariant": "solid"
    },
    "raw": "(model) => ({\n    ...model,\n                                                                              \n    dataSourceType: 'referenceList',\n                                                                                                     \n    values: defaultValuesSetting(),\n    showItemName: true,\n    showIcon: true,\n    tagVariant: 'solid',\n  })"
  },
