  "sourceFiles": [
    "dataList/dataListComponent.tsx",
    "dataList/model.tsx"
  ],
  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 8,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    },
    {
      "toVersion": 9,
      "category": "curated",
      "what": "cardSpacing/cardMinWidth/cardMaxWidth/customWidth/cardHeight -> desktop.gap and desktop.dimensions"
    },
    {
      "toVersion": 10,
      "category": "curated",
      "what": "cardSpacing -> numeric gap; desktop.dimensions min/max/width/height default \"auto\""
    },
    {
      "toVersion": 12,
      "category": "VISIBLE_PERMS",
      "what": "hidden -> visible (inverted) and permissions -> visiblePermissions"
    }
  ]
