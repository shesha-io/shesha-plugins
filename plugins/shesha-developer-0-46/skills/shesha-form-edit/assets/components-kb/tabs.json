  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "This will set the position for all buttons"
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "textField",
