      "editorType": "switch",
      "group": "Behaviour"
    },
    {
      "path": "allowViewHistory",
      "label": "Allow View History",
      "editorType": "switch",
      "group": "Behaviour"
    },
    {
      "path": "downloadZip",
      "label": "Download Zip",
      "editorType": "switch",
      "group": "Behaviour"
    },
    {
      "path": "ownerName",
      "label": "Bound Property",
      "editorType": "propertyAutocomplete",
      "group": "Data"
    },
    {
