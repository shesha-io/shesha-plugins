    "raw": "(model) => {\n    const id = nanoid();\n    const tabsModel: ITabsComponentProps = {\n      ...model,\n      propertyName: 'custom Name',\n      tabPosition: \"top\",\n      tabs: [{ id: id, name: 'Tab 1', key: id, title: 'Tab 1', visible: true, editMode: 'inherited', components: [] }],\n    };\n    return tabsModel;\n  }"
  },
