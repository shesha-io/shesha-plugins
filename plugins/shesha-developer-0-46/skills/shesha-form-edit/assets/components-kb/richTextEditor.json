  "settingsForm": {
    "source": "richTextEditor/formSettings.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "If yes, will automatically be focused (be selected component) when the page loads"
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "placeholder",
      "label": "Placeholder",
      "editorType": "textField"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "editMode",
      "label": "Edit Mode",
      "editorType": "editModeSelector"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "switch"
    },
    {
      "path": "toolbar",
      "label": "Show Toolbar",
      "editorType": "switch",
      "group": "Toolbar"
    },
    {
      "path": "toolbarButtonSize",
      "label": "Size Of Icons",
      "editorType": "dropdown",
      "options": [
        "tiny",
        "xsmall",
        "middle",
        "large"
      ],
      "group": "Toolbar"
    },
    {
      "path": "disablePlugins",
      "label": "Hidden Actions",
      "editorType": "dropdown",
      "options": [
        "add-new-line",
        "about",
        "focus",
        "class-span",
        "backspace",
        "bold",
        "wrap-nodes",
        "clean-html",
        "copy-format",
        "clipboard",
        "paste",
        "paste-storage",
        "drag-and-drop",
        "drag-and-drop-element",
        "paste-from-word",
        "color",
        "enter",
        "key-arrow-outside",
        "error-messages",
        "font",
        "format-block",
        "fullsize",
        "hotkeys",
        "iframe",
        "indent",
        "hr",
        "inline-popup",
        "justify",
        "line-height",
        "limit",
        "link",
        "mobile",
        "ordered-list",
        "powered-by-jodit",
        "placeholder",
        "redo-undo",
        "resizer",
        "search",
        "select",
        "size",
        "resize-handler",
        "source",
        "stat",
        "sticky",
        "spellcheck",
        "symbols",
