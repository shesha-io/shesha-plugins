    [
     "components/0/desktop/stylingBoxJson/paddingRight",
     "16"
    ],
    [
     "components/0/desktop/stylingBoxJson/paddingBottom",
     "16"
    ],
    [
     "components/0/desktop/stylingBoxJson/paddingLeft",
     "16"
    ],
    [
     "components/0/desktop/stylingBoxJson/_type",
     "styleBox"
    ]
   ],
   "node": false,
   "retire": false,
   "touched": [
    "components/0/desktop"
   ]
  },
  {
   "name": "an author-chosen font size is kept",
   "form": "Shop/order-details",
   "markup": {
    "components": [
     {
      "id": "txt",
