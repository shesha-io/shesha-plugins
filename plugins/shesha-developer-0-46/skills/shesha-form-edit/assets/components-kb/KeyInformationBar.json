{
  "type": "KeyInformationBar",
  "name": "Key Information Bar",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "BorderLeftOutlined",
  "version": 5,
  "allowInherit": true,
  "styleGroup": "common-containers",
  "isHidden": false,
  "customContainerNames": [
    "columns"
  ],
  "hasGetContainers": false,
  "defaultStylesFrom": "defaultStyles",
  "initModel": {
    "defaults": {
      "propertyName": "column 1"
    },
    "raw": "(model) => {\n    const tabsModel: IKeyInformationBarComponentProps = {\n      ...model,\n      propertyName: 'column 1',\n      columns: [\n        {\n          id: nanoid(),\n          width: 200,\n          textAlign: 'center',\n          flexDirection: 'column',\n          components: [],\n          padding: '0px',\n        },\n      ],\n    };\n\n    return tabsModel;\n  }"
  },
  "settingsProps": {
    "interfaceName": "IKeyInformationBarComponentProps",
    "interfaceFile": "designer-components/keyInformationBar/interfaces.ts",
    "ownProps": [
      "width",
      "height",
      "dividerHeight",
      "dividerWidth",
      "dividerMargin",
      "dividerColor",
      "dividerThickness",
      "gap",
      "alignItems",
      "orientation",
      "columns",
      "readOnly",
      "style",
      "itemsStyle",
      "stylingBox",
      "backgroundColor"
    ],
    "extends": [
      "IConfigurableFormComponent",
      "IInputStyles"
    ],
    "resolvedProps": [
      "_formFields",
      "alignItems",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "availableConstantsExpression",
      "background",
      "backgroundBase64",
      "backgroundColor",
