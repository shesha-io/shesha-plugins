{
  "type": "dropdown",
  "name": "Dropdown",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "DownSquareOutlined",
  "version": 15,
  "allowInherit": true,
  "styleGroup": "inputs",
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": "() => defaultStyles()",
  "initModel": null,
  "settingsProps": {
    "interfaceName": "IDropdownComponentProps",
    "interfaceFile": "designer-components/dropdown/model.ts",
    "ownProps": [],
    "extends": [
      "IDropdownProps",
      "IConfigurableFormComponent",
      "IInputStyles"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
