{
 "rule": "textsize",
 "cases": [
  {
   "name": "font and padding presets rewritten at the 16px root",
   "form": "Shop/order-details",
   "markup": {
    "components": [
     {
      "id": "txt",
      "type": "text",
      "componentName": "txt",
      "parentId": "root",
      "fontSize": "text-xl",
      "padding": "padding-base",
      "desktop": {
       "font": {
        "size": 17.5
       }
      }
     }
    ]
   },
   "changes": 2,
