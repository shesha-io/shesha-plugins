{
  "type": "richTextEditor",
  "name": "Rich Text Editor",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": null,
  "icon": "EditOutlined",
  "version": 6,
  "allowInherit": false,
  "styleGroup": null,
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": null,
  "initModel": {
    "defaults": {
      "showCharsCounter": true,
      "showWordsCounter": true,
      "showXPathInStatusbar": true,
      "minHeight": 200,
      "minWidth": 200,
      "toolbar": true,
      "useSearch": true,
      "autoHeight": true,
      "autoWidth": true,
      "askBeforePasteHTML": true,
      "askBeforePasteFromWord": true
    },
    "raw": "(model) => ({\n    ...model,\n    showCharsCounter: true,\n    showWordsCounter: true,\n    showXPathInStatusbar: true,\n    minHeight: 200,\n    minWidth: 200,\n    toolbar: true,\n    useSearch: true,\n    autoHeight: true,\n    autoWidth: true,\n    askBeforePasteHTML: true,\n    askBeforePasteFromWord: true,\n  })"
  },
  "settingsProps": {
