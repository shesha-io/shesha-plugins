      "visible",
      "visiblePermissions",
      "width",
      "wrapperStyle",
      "wrapperStyleCss"
    ],
    "unresolvedExtends": []
  },
  "settingsForm": {
    "source": "numberField/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": true,
  "appearanceFieldPaths": [
    "font",
    "dimensions",
    "border",
    "background",
    "shadow",
    "stylingBoxJson",
    "style"
  ],
  "appearanceScope": "per-device",
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "numbro.js like format (https://numbrojs.com/old-format.html) or you can use JS mode to implement any transformation"
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "placeholder",
      "label": "Placeholder",
      "editorType": "textField"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    },
    {
      "path": "editMode",
      "label": "Interaction Mode",
      "editorType": "editModeSelector",
      "permissionSettings": true
    },
    {
      "path": "numberFormat",
      "label": "Format",
      "editorType": "dropdown",
      "group": "Format"
    },
    {
      "path": "prefix",
      "label": "Prefix",
      "editorType": "textField"
    },
    {
      "path": "prefixIcon",
      "label": "Prefix Icon",
      "editorType": "iconPicker"
    },
    {
      "path": "suffix",
      "label": "Suffix",
      "editorType": "textField"
    },
    {
      "path": "suffixIcon",
      "label": "Suffix Icon",
      "editorType": "iconPicker"
    },
    {
      "path": "validate.required",
      "label": "Required",
      "editorType": "switch",
      "group": "Validations"
    },
    {
      "path": "validate.minValue",
      "label": "Min Value",
      "editorType": "numberField",
      "description": "Minimum allowed value, leave empty for no limit",
      "group": "Validations"
    },
    {
      "path": "validate.maxValue",
      "label": "Max Value",
      "editorType": "numberField",
      "description": "Maximum allowed value, leave empty for no limit",
      "group": "Validations"
    },
    {
      "path": "onChangeCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onFocusCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onBlurCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onClickCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onMouseEnterCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onMouseMoveCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onMouseLeaveCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onKeyDownCustom",
      "editorType": "codeEditor",
      "group": "Events"
    },
    {
      "path": "onKeyUpCustom",
      "editorType": "codeEditor",
      "group": "Events"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "numberField/numberField.tsx",
    "numberField/interfaces.ts"
  ],
  "reworked": true,
  "registeredInToolbox": true,
  "renderImpact": [
    {
      "toVersion": 2,
      "category": "READONLY",
      "what": "readOnly/disabled -> editMode (Interaction Mode)"
    },
    {
      "toVersion": 4,
      "category": "STYLE_COPY",
      "what": "Root-level legacy style props copied into desktop/tablet/mobile blocks (precursor of migratePrevStyles)"
    },
    {
      "toVersion": 5,
      "category": "STYLE_BLOCKS",
      "what": "Legacy flat style props (size/width/height/border*/font*/backgroundColor/stylingBox/style) converted to the structured desktop/tablet/mobile style blocks (border/background/font/dimensions/shadow) via migratePrevStyles, "
    },
    {
      "toVersion": 6,
      "category": "VISIBLE_STYLINGJSON",
      "what": "min/max -> validate.minValue/maxValue; hidden->visible, stylingBox->stylingBoxJson"
    }
  ]
}
