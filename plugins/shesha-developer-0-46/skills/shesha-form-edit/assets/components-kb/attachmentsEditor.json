    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "How each file is presented: as its name, or as a tile at a preset size. Custom Thumbnail takes its size from the Thumbnail Style dimensions."
    },
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "textArea"
    },
    {
      "path": "visible",
      "label": "Visible",
      "editorType": "switch",
      "permissionSettings": true
    },
    {
      "path": "editMode",
      "label": "Interaction Mode",
      "editorType": "editModeSelector",
      "permissionSettings": true
    },
    {
      "path": "displayStyle",
      "label": "Display Style",
      "editorType": "dropdown",
      "description": "How each file is presented: as its name, or as a tile at a preset size. Custom Thumbnail takes its size from the Thumbnail Style dimensions.",
      "group": "Display"
    },
    {
      "path": "isDragger",
      "label": "Is Dragger",
      "editorType": "switch",
      "description": "Whether the uploader should show a drop area instead of a button.",
      "group": "Display"
    },
    {
      "path": "hideFileName",
      "label": "Hide File Name",
      "editorType": "switch",
      "group": "Display"
    },
    {
      "path": "dropzoneText",
      "label": "Dropzone Text",
      "editorType": "textArea",
      "description": "Replaces the prompt in the drop area. Left empty, it keeps the stock wording and its hint; set, it stands alone, and its line breaks are shown.",
      "group": "Display"
    },
    {
      "path": "emptyText",
      "label": "Empty Text",
      "editorType": "textArea",
      "description": "Shown when there are no files and none can be added — a read-only or disabled list. Left empty, such a list renders nothing at all.",
      "group": "Display"
    },
    {
      "path": "allowAdd",
      "label": "Allow Add",
      "editorType": "switch",
      "group": "Behaviour"
    },
    {
      "path": "allowDelete",
      "label": "Allow Remove",
      "editorType": "switch",
      "group": "Behaviour"
    },
    {
      "path": "allowReplace",
      "label": "Allow Replace",
      "editorType": "switch",
      "group": "Behaviour"
    },
    {
      "path": "allowRename",
