{
  "type": "numberField",
  "name": "Number field",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "NumberOutlined",
  "version": 7,
  "allowInherit": true,
  "styleGroup": "inputs",
  "isHidden": false,
  "customContainerNames": null,
  "hasGetContainers": false,
  "defaultStylesFrom": "() => defaultStyles()",
  "initModel": {
    "defaults": null,
    "raw": "(model) => ({\n    ...model,\n  })"
  },
  "settingsProps": {
    "interfaceName": "INumberFieldComponentProps",
    "interfaceFile": "designer-components/numberField/interfaces.ts",
    "ownProps": [
